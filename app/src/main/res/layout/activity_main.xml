<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ZeroLag Gestures"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OnePlus 15R + Niagara Launcher"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="INACTIVE"
                android:textColor="@color/accent_red"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Service Toggle Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Master Switch"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Starts the zero-lag touch interceptor bar at the bottom edge."
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnToggleService"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/btn_gradient"
                android:text="@string/action_toggle_service"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Permissions Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Required Permissions"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Overlay Permission -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1. Draw Over Apps (Overlay)"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Intercepts bottom swipes before OnePlus Quickstep"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnGrantOverlay"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="Grant"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Accessibility Permission -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2. Accessibility Service"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Provides instant Home, Recents, and Back triggers"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnGrantAccessibility"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="Enable"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Customization Settings Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gesture Configuration"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Bar Height -->
            <TextView
                android:id="@+id/tvHeightLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Touch Trigger Zone Height: 28 dp"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:layout_marginTop="12dp" />

            <SeekBar
                android:id="@+id/sbBarHeight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="60"
                android:progress="28"
                android:layout_marginTop="4dp" />

            <!-- Visual Pill Toggle -->
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchShowPill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Show Visual Bottom Pill"
                android:textColor="@color/text_primary"
                android:checked="true"
                android:layout_marginTop="8dp" />

            <!-- Direct Niagara Intent -->
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchDirectNiagara"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Direct Niagara Launch (Instant 0ms)"
                android:textColor="@color/text_primary"
                android:checked="true"
                android:layout_marginTop="8dp" />

            <!-- Haptic Vibration -->
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchHaptics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Haptic Feedback on Gesture"
                android:textColor="@color/text_primary"
                android:checked="true"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- OxygenOS 16 Setup Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ OxygenOS 16 Essential Setup"
                android:textColor="@color/accent_cyan"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="To completely remove the 1-second freeze on OnePlus:\n\n1. Set System Navigation to 3-Button Navigation (this disables OnePlus's broken Quickstep gesture engine). This app's gesture bar replaces the buttons with smooth swipe gestures.\n\n2. Settings > Apps > App battery management > Niagara Launcher > Turn ON 'Allow background activity' and 'Allow auto-launch'.\n\n3. Settings > Apps > App battery management > ZeroLag Gestures > Turn ON 'Allow background activity'."
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
